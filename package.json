{
  "name": "aviixa-interactive-storyboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:registries && rm -rf out && next build",
    "serve:out": "rm -rf .serve-snapshot && cp -R out .serve-snapshot && serve .serve-snapshot -p 4173 -L",
    "build:registries": "node scripts/build-registries.mjs && node scripts/build-doh-module-reach.mjs && node scripts/build-stu-module-reach.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:release": "vitest run --project release",
    "test:e2e": "playwright test --project=chromium",
    "test:freshness": "vitest run --project release tests/coverage/registry-freshness.test.ts",
    "check:gate-ordering": "node scripts/check-gate-ordering.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:gate-ordering && pnpm test:freshness && pnpm test:unit && pnpm test:component && pnpm build && pnpm test:release && pnpm test:e2e",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
