  {
    "id": "TOUR-TENANT-PROVISION-001",
    "version": "1.0.0",
    "title": "Provisioning a new tenant, through the wizard's own validation",
    "workflowId": null,
    "variant": "nominal",
    "seed": "SEED-CANONICAL-BRIGHTBIKES",
    "startCheckpoint": "Shift start",
    "steps": [
      {
        "id": "nav-home",
        "narration": "Start at the storyboard's entry point.",
        "action": {
          "kind": "navigate",
          "route": "/"
        },
        "expectRoute": "/"
      },
      {
        "id": "nav-sign-in",
        "narration": "Helena Voss, a platform Admin, opens the Super Admin console sign-in page.",
        "action": {
          "kind": "navigate",
          "route": "/super-admin/sign-in/"
        },
        "expectRoute": "/super-admin/sign-in/"
      },
      {
        "id": "type-email",
        "narration": "She enters her work email.",
        "action": {
          "kind": "type",
          "controlId": "field-email",
          "value": "helena.voss@platform.aviixa.example"
        },
        "spotlight": "field-email",
        "expectVisible": "field-email"
      },
      {
        "id": "type-password",
        "narration": "...and a password — this storyboard accepts any non-empty password for an active account.",
        "action": {
          "kind": "type",
          "controlId": "field-password",
          "value": "reviewer-demo"
        },
        "expectVisible": "field-password"
      },
      {
        "id": "submit-sign-in",
        "narration": "She signs in.",
        "action": {
          "kind": "click",
          "controlId": "sign-in-submit"
        },
        "spotlight": "sign-in-submit"
      },
      {
        "id": "land-dashboard",
        "narration": "Sign-in lands her on the platform dashboard, the console's home surface.",
        "action": {
          "kind": "assertState",
          "description": "The sign-in redirect has resolved.",
          "check": "demo-role-simulator"
        },
        "expectRoute": "/super-admin/platform-overview-and-health/"
      },
      {
        "id": "nav-tenants",
        "narration": "She opens the tenant list.",
        "action": {
          "kind": "navigate",
          "route": "/super-admin/tenants-lifecycle-and-pilots/"
        },
        "expectRoute": "/super-admin/tenants-lifecycle-and-pilots/"
      },
      {
        "id": "click-create",
        "narration": "She clicks Create tenant.",
        "action": {
          "kind": "click",
          "controlId": "tenants-create"
        },
        "spotlight": "tenants-create",
        "expectRoute": "/super-admin/tenants-lifecycle-and-pilots/create/"
      },
      {
        "id": "type-tenant-name",
        "narration": "She types the new tenant's name.",
        "action": {
          "kind": "type",
          "controlId": "field-name",
          "value": "Meridian Robotics"
        },
        "expectVisible": "field-name"
      },
      {
        "id": "advance-to-commercial",
        "narration": "With the name valid, Next advances to Commercial.",
        "action": {
          "kind": "click",
          "controlId": "wizard-next"
        },
        "expectVisible": "field-tier-starter"
      },
      {
        "id": "select-growth-tier",
        "narration": "She selects the Growth tier.",
        "action": {
          "kind": "click",
          "controlId": "field-tier-growth"
        },
        "expectVisible": "field-tier-growth"
      },
      {
        "id": "advance-to-admin",
        "narration": "Commercial is valid by default; Next advances to First administrator.",
        "action": {
          "kind": "click",
          "controlId": "wizard-next"
        },
        "expectVisible": "field-adminDisplayName"
      },
      {
        "id": "type-admin-name",
        "narration": "She names the tenant's first administrator.",
        "action": {
          "kind": "type",
          "controlId": "field-adminDisplayName",
          "value": "Jordan Cole"
        },
        "expectVisible": "field-adminDisplayName"
      },
      {
        "id": "type-admin-email",
        "narration": "...and their email — the address the invitation goes to.",
        "action": {
          "kind": "type",
          "controlId": "field-adminEmail",
          "value": "jordan.cole@meridianrobotics.example"
        },
        "expectVisible": "field-adminEmail"
      },
      {
        "id": "advance-to-review",
        "narration": "Both administrator fields are valid; Next advances to Review.",
        "action": {
          "kind": "click",
          "controlId": "wizard-next"
        },
        "expectVisible": "create-tenant-review-confirm-trigger"
      },
      {
        "id": "open-confirm",
        "narration": "She opens the review confirmation.",
        "action": {
          "kind": "click",
          "controlId": "create-tenant-review-confirm-trigger"
        },
        "expectVisible": "create-tenant-confirm-confirm"
      },
      {
        "id": "confirm-create",
        "narration": "She confirms the tenant and its administrator invitation.",
        "action": {
          "kind": "click",
          "controlId": "create-tenant-confirm-confirm"
        }
      },
      {
        "id": "finish-create",
        "narration": "Finish commits the tenant and its administrator invitation as one real write.",
        "action": {
          "kind": "click",
          "controlId": "wizard-next"
        }
      },
      {
        "id": "land-detail",
        "narration": "The write lands her on the new tenant's detail page, Invited. Activate is present but disabled: no administrator has accepted the invitation yet.",
        "action": {
          "kind": "assertState",
          "description": "Landed on the new tenant's own detail page.",
          "check": "tenant-detail-activate"
        },
        "expectRoute": "/super-admin/tenants-lifecycle-and-pilots/detail/"
      }
    ]
  },
  {
    "id": "TOUR-TENANT-ACTIVATION-001",
    "version": "1.0.0",
    "title": "A Tenant Admin accepts, and the platform team activates the workspace",
    "workflowId": null,
    "variant": "nominal",
    "seed": "SEED-CANONICAL-BRIGHTBIKES",
    "startCheckpoint": "Shift start",
    "steps": [
      {
        "id": "nav-home",
        "narration": "Start at the storyboard's entry point, signed out. This tour continues the provisioning tour's story on a tenant already seeded in the same 'invited, not yet accepted' state — accepting an invitation needs a signed-out session, and no write from a separate create-tenant run survives into this one.",
        "action": {
          "kind": "navigate",
          "route": "/"
        },
        "expectRoute": "/"
      },
      {
        "id": "nav-accept",
        "narration": "Nadia Ferreira opens the invitation link Ironclad Fasteners' Tenant Admin was sent.",
        "action": {
          "kind": "navigate",
          "route": "/hub/accept-invitation/?tenant=TEN-IRONCLAD"
        },
        "expectRoute": "/hub/accept-invitation/"
      },
      {
        "id": "accept",
        "narration": "She accepts the invitation — a real write that activates her own account.",
        "action": {
          "kind": "click",
          "controlId": "accept-invitation-submit"
        },
        "spotlight": "accept-invitation-submit"
      },
      {
        "id": "land-hub",
        "narration": "Accepting lands her, signed in, on the Hub — her workspace is visible but not yet operating.",
        "action": {
          "kind": "assertState",
          "description": "Landed in the Hub as the newly active Tenant Admin.",
          "check": "demo-role-simulator"
        }
      },
      {
        "id": "nav-sign-in-again",
        "narration": "Meanwhile, Helena Voss, a platform Admin, opens the console sign-in page to activate the workspace now that its administrator has accepted.",
        "action": {
          "kind": "navigate",
          "route": "/super-admin/sign-in/"
        },
        "expectRoute": "/super-admin/sign-in/"
      },
      {
        "id": "type-email-2",
        "narration": "She enters her work email.",
        "action": {
          "kind": "type",
          "controlId": "field-email",
          "value": "helena.voss@platform.aviixa.example"
        },
        "expectVisible": "field-email"
      },
      {
        "id": "type-password-2",
        "narration": "...and a password.",
        "action": {
          "kind": "type",
          "controlId": "field-password",
          "value": "reviewer-demo"
        },
        "expectVisible": "field-password"
      },
      {
        "id": "submit-sign-in-2",
        "narration": "She signs in — this build's sign-in form has no separate sign-out step, so a fresh sign-in simply replaces the prior session.",
        "action": {
          "kind": "click",
          "controlId": "sign-in-submit"
        },
        "spotlight": "sign-in-submit"
      },
      {
        "id": "land-dashboard-2",
        "narration": "Sign-in lands her on the platform dashboard.",
        "action": {
          "kind": "assertState",
          "description": "The sign-in redirect has resolved.",
          "check": "demo-role-simulator"
        },
        "expectRoute": "/super-admin/platform-overview-and-health/"
      },
      {
        "id": "nav-detail",
        "narration": "She opens Ironclad Fasteners' own detail page.",
        "action": {
          "kind": "navigate",
          "route": "/super-admin/tenants-lifecycle-and-pilots/detail/?tenant=TEN-IRONCLAD"
        },
        "expectRoute": "/super-admin/tenants-lifecycle-and-pilots/detail/"
      },
      {
        "id": "assert-activate-enabled",
        "narration": "With Nadia's acceptance now on record, Activate is enabled.",
        "action": {
          "kind": "assertState",
          "description": "Activate is reachable now that the administrator has accepted.",
          "check": "tenant-detail-activate"
        }
      },
      {
        "id": "click-activate",
        "narration": "She clicks Activate.",
        "action": {
          "kind": "click",
          "controlId": "tenant-detail-activate"
        },
        "spotlight": "tenant-detail-activate",
        "expectVisible": "tenant-detail-lifecycle-confirm-confirm"
      },
      {
        "id": "confirm-activate",
        "narration": "...and confirms — a real write moving the tenant from Invited to Active.",
        "action": {
          "kind": "click",
          "controlId": "tenant-detail-lifecycle-confirm-confirm"
        }
      },
      {
        "id": "activated",
        "narration": "The confirmation banner reads that Ironclad Fasteners is now Active.",
        "action": {
          "kind": "assertState",
          "description": "The write landed.",
          "check": "tenant-detail-write-feedback"
        }
      },
      {
        "id": "nav-list",
        "narration": "Back on the tenant list...",
        "action": {
          "kind": "navigate",
          "route": "/super-admin/tenants-lifecycle-and-pilots/"
        },
        "expectRoute": "/super-admin/tenants-lifecycle-and-pilots/"
      },
      {
        "id": "search-ironclad",
        "narration": "...searching for Ironclad Fasteners shows its row now carrying the Active status.",
        "action": {
          "kind": "type",
          "controlId": "dt-tenants-search",
          "value": "Ironclad"
        },
        "expectVisible": "dt-tenants-row-TEN-IRONCLAD"
      }
    ]
  },
